{
  "id": "PostpomogoteCss",
  "project": "am-news",
  "name": "CSS Import — post pomogote",
  "description": "Импортировано из Figma CSS (post pomogote), family: news-126",
  "tag": "Import",
  "templateDir": "post-pomogote",
  "preset": "soft-float",
  "durationFrames": 90,
  "imported": true,
  "propsFields": [
    {"key": "quote", "type": "textarea", "label": "Quote"},
    {"key": "label", "type": "string", "label": "Label"},
    {"key": "title", "type": "string", "label": "Title"},
    {"key": "quoteColor", "type": "color", "label": "Quote color"},
    {"key": "labelColor", "type": "color", "label": "Label color"},
    {"key": "titleColor", "type": "color", "label": "Title color"},
    {"key": "image", "type": "image", "label": "Image"},
    {"key": "background", "type": "color", "label": "Background"}
  ],
  "defaultProps": {
    "image": "generated/post-126.png",
    "background": "#D9DDE0",
    "quote": "Armenia welcomed 172,705 international visitors in April 2026",
    "quoteColor": "#D61E23",
    "label": "AM NEWS",
    "labelColor": "#4A7BFF",
    "title": "Hello, WORLD",
    "titleColor": "#0F0F10"
  }
