# LLM (OpenAI)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=120000
LLM_RETRIES=3

# fal.ai — этап C (генерация изображений)
FAL_API_KEY=
FAL_MODEL=fal-ai/nano-banana-2
FAL_RESOLUTION=1K
FAL_ASPECT_RATIO=4:5

# Кастомный цвет поста в UI
ADMIN=0

# Встроенная вкладка News / Trends
DASHBOARD_PORT=3010
DASHBOARD_ORIGIN=http://127.0.0.1:3010
